{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "dependencyDashboardApproval": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned commit of the pnpm install script",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.ya?ml$/",
        "/(^|/)\\.gitlab/.+$/",
        "/(^|/)\\.github/.+$/",
        "/(^|/)\\.devcontainer/.+$/",
        "/(^|/)scripts/.+$/",
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)[^/]+\\.Dockerfile$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/pnpm/get\\.pnpm\\.io/(?<currentDigest>[a-f0-9]{40})/install\\.sh"
      ],
      "depNameTemplate": "pnpm/get.pnpm.io",
      "packageNameTemplate": "https://github.com/pnpm/get.pnpm.io",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Wait for releases to mature (npm is already covered by security:minimumReleaseAgeNpm from config:best-practices)",
      "matchDatasources": ["!npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Only images from Docker Hub have a release timestamp, so others would get stuck",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["helm_release"],
      "pinDigests": false
    }
  ]
}
